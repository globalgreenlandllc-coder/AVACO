# All of these are server-only secrets/config. Never prefix any of them with NEXT_PUBLIC_.

# AVOCO upstream
AVOCO_API_USER=
AVOCO_API_PASSWORD=
# Defaults to https://voice.voxera.kz when empty
AVOCO_BASE_URL=

# Your platform's own permanent API keys (comma-separated). Generate each with: openssl rand -hex 32
PLATFORM_API_KEYS=

# Protects POST /api/webhooks/avoco (AVOCO callbacks are unsigned). Generate with: openssl rand -hex 32
AVOCO_CALLBACK_SECRET=

# Public PRODUCTION URL of this API, e.g. https://avoco-gateway.vercel.app — used to build callback URLs
APP_BASE_URL=

# Postgres (Neon). Set automatically by the Vercel Marketplace integration
DATABASE_URL=

# Vercel Blob. Set automatically when a Blob store is connected to the project
BLOB_READ_WRITE_TOKEN=

# Hosts audio_url may point to (comma-separated). Leading dot = any subdomain.
# Defaults to .blob.vercel-storage.com when empty
ALLOWED_AUDIO_HOSTS=
