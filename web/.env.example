# AVOCO Gateway (../backend-api). Server-only: never prefix these with NEXT_PUBLIC_.
GATEWAY_URL=
GATEWAY_API_KEY=

# Clerk (https://dashboard.clerk.com → API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/record
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/record

# Admin portal (/admin): comma-separated emails that may open it
ADMIN_EMAILS=

# Seals secrets an admin pastes into /admin/settings (the Stripe keys). Any long random string; generate with: openssl rand -hex 32
SETTINGS_SECRET=

# DeepL (extra languages). Normally connected in /admin/settings; this environment value is only a fallback
DEEPL_API_KEY=

# Stripe (card payments). Normally connected in /admin/settings; these environment values are only a fallback
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Postgres (the same Neon database as the gateway)
DATABASE_URL=
